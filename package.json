{
  "name": "diana-codex-theme",
  "version": "0.2.2",
  "description": "Safe Diana visual blueprints and artwork for Codex, plus a verified Windows Terminal theme.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lanmengSakura/diana-codex-theme.git"
  },
  "engines": {
    "node": ">=22.4"
  },
  "scripts": {
    "security:audit": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/audit-legacy-cdp.ps1",
    "security:remove-legacy": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/remove-legacy-cdp.ps1",
    "theme:status": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/audit-legacy-cdp.ps1",
    "theme:uninstall": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/remove-legacy-cdp.ps1",
    "terminal:validate": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File terminal/validate-diana-terminal.ps1",
    "terminal:build": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File terminal/build-terminal-background.ps1",
    "terminal:showcase": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File terminal/render-terminal-showcase.ps1",
    "terminal:pack": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File terminal/pack-terminal-release.ps1",
    "terminal:install": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File terminal/install-diana-terminal.ps1",
    "terminal:default": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File terminal/install-diana-terminal.ps1 -SetDefault",
    "terminal:open": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File terminal/install-diana-terminal.ps1 -Open",
    "terminal:shortcut": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File terminal/new-diana-terminal-shortcut.ps1",
    "terminal:uninstall": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File terminal/uninstall-diana-terminal.ps1",
    "preview:open": "powershell.exe -NoProfile -Command Start-Process (Resolve-Path 'preview/index.html')",
    "validate": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File skills/diana-codex-theme/scripts/validate-theme.ps1",
    "skill:verify": "node skills/diana-codex-theme/scripts/verify-bundle.mjs",
    "skill:pack": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/pack-skill-release.ps1",
    "release:sanitize": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/prepare-safe-release.ps1",
    "release:pack": "npm run release:sanitize && npm run terminal:pack && npm run skill:pack",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run test && npm run terminal:validate && npm run skill:verify && npm run validate && npm run release:sanitize"
  }
}
